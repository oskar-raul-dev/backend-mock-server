						"localhost"
					],
					"port": "9090",
					"path": [
						"_health"
					]
				},
				"description": "Built-in health check endpoint that returns server status and uptime.\n\n**Features:**\n- Server health monitoring\n- Uptime tracking\n\n**Expected Response:**\n```json\n{\n    \"status\": \"healthy\",\n    \"uptime\": <seconds>\n}\n```"
			},
			"response": []
